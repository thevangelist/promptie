#!/usr/bin/env python3
"""Append one line to the {{NAME}} index without reading the file.

Exists so the permission rule can name this exact script instead of granting a
broad write. Write-only by construction: it opens the index in append mode and
never reads it back.

Generated by promptie from {{PERSONA_FILE}}. Edit the persona, not this file.

Usage: append_index.py <NNNNN> <YYYY-MM-DD> <slug> <scope> <kind> <hook text...>
"""

import io
import os
import re
import sys

STORE = os.path.expanduser(r"{{STORE}}")
SCOPES = {{SCOPE_PY_LIST}}
KINDS = {{KIND_PY_LIST}}
PROMOTABLE = {{PROMOTABLE_PY_LIST}}
RESTRICTIVE = "{{RESTRICTIVE_SCOPE}}"


def fail(message):
    sys.stderr.write(message + "\n")
    raise SystemExit(2)


def main(argv):
    if len(argv) < 7:
        fail("usage: append_index.py <NNNNN> <YYYY-MM-DD> <slug> <scope> <kind> <hook text...>")

    number, date, slug, scope, kind = argv[1:6]
    hook = " ".join(argv[6:])

    if not re.match(r"^([0-9][0-9A-Z]{4}|[A-Z]\d{4}|\d{6,9})$", number):
        fail("number must be a five-character id like 00001 or A0001, got: %s" % number)
    if not re.match(r"^\d{4}-\d{2}-\d{2}$", date):
        fail("date must be YYYY-MM-DD, got: %s" % date)
    if not re.match(r"^[a-z0-9]+(-[a-z0-9]+)*$", slug):
        fail("slug must be lower-case kebab-case, got: %s" % slug)
    if scope not in SCOPES:
        fail("scope must be one of: %s -- got: %s" % (", ".join(SCOPES), scope))
    if kind not in KINDS:
        fail("kind must be one of: %s -- got: %s" % (", ".join(KINDS), kind))

    # Verify the note the assistant just wrote actually carries the date, and the
    # same date it is claiming here. Numbering is guaranteed by the allocator;
    # without this check the date is only guaranteed by instruction, and an
    # undated note cannot be placed in time later.
    #
    # This reads a file, but not in the sense the write-only rule forbids: it
    # inspects the note the caller wrote seconds ago and returns pass or fail.
    # No stored content reaches the assistant.
    note = os.path.join(STORE, "%s-%s.md" % (number, slug))
    if os.path.exists(note):
        with io.open(note, "r", encoding="utf-8") as fh:
            head = fh.read(400)
        if ("captured: %s" % date) not in head:
            fail("note %s-%s.md is missing 'captured: %s' in its frontmatter. "
                 "Add it, then run this again. Every note carries the date it "
                 "was written." % (number, slug, date))
    else:
        fail("no note at %s. Write the note first, then add the index line."
             % note)

    os.makedirs(STORE, exist_ok=True)
    line = "- `%s` - `%s` - [%s](%s-%s.md) - `%s` - `%s` - %s\n" % (
        number, date, slug, number, slug, kind, scope, hook)

    # Append mode, explicit UTF-8: the index is never read, and the encoding is
    # not left to the platform default (which is not UTF-8 on Windows).
    with io.open(os.path.join(STORE, "INDEX.md"), "a", encoding="utf-8") as fh:
        fh.write(line)

    # Flag, never promote. A constraint or a rationale below the most restrictive
    # scope has the shape of a publishable principle, so it earns a line on a
    # shortlist the human reviews. The assistant never reads this file, and
    # nothing here moves a note anywhere -- promotion stays a human action.
    if kind in PROMOTABLE and scope != RESTRICTIVE:
        with io.open(os.path.join(STORE, "CANDIDATES.md"), "a", encoding="utf-8") as fh:
            fh.write(line)

    sys.stdout.write("appended: %s-%s\n" % (number, slug))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
