#!/usr/bin/env python3
"""{{TITLE}} capture hooks. One file, three entry points, selected by argv[1].

Kept as a single file so a persona installs three hooks without three near-identical
scripts drifting apart.

  arm      SessionStart  -- arms capture for the session
  notify   PostToolUse   -- tells the user what was saved
  sweep    PreCompact    -- catches insight before the context window is discarded

Pure standard library, so it runs the same on macOS, Linux, BSD and Windows. Every
path exits 0: a capture hook must never be able to block or break a session.

The store is write-only from the assistant's side. `notify` looks at the written
path only -- it never opens the note.

Generated by promptie from {{PERSONA_FILE}}. Edit the persona, not this file.
"""

import json
import os
import re
import sys

STORE = os.path.expanduser(r"{{STORE}}")
ICON = "{{ICON}}"
ARM_TEXT = {{ARMING_LINE_PY}}
SWEEP_TEXT = {{SWEEP_LINE_PY}}

NOTE_RE = re.compile(r"^([0-9][0-9A-Z]{4}|[A-Z]\d{4}|\d{6,9})-([a-z0-9-]+)\.md$")


def disabled():
    """Two ways to switch capture off, both checked before any work happens.

    A throwaway session -- toy code, odd inputs, a demo -- should cost nothing and
    leave nothing behind. Returning early here means zero injected context and no
    note, rather than a note the human has to prune later.
    """
    if os.environ.get("PROMPTIE_DISABLE", "").strip() not in ("", "0", "false"):
        return True
    directory = os.getcwd()
    while True:
        if os.path.exists(os.path.join(directory, ".promptieignore")):
            return True
        parent = os.path.dirname(directory)
        if parent == directory:
            return False
        directory = parent


def project_focus():
    """What this particular project wants captured, if it says so.

    A `.promptie` file in the project root (or any parent) holds a sentence or two
    of free text: "in this repo, capture routing and cache invalidation decisions".
    It is appended to the session arming line, so the persona stays global while
    the emphasis becomes local.

    Free text rather than a schema on purpose -- the assistant reads it, and the
    moment it needs fields it stops being something you write in ten seconds.
    """
    directory = os.getcwd()
    while True:
        candidate = os.path.join(directory, ".promptie")
        if os.path.isfile(candidate):
            try:
                with open(candidate, "r", encoding="utf-8", errors="replace") as fh:
                    # Capped: this rides in the session context, and a project that
                    # needs an essay here is really asking for its own persona.
                    return " ".join(fh.read().split())[:400]
            except (IOError, OSError):
                return ""
        parent = os.path.dirname(directory)
        if parent == directory:
            return ""
        directory = parent


def emit(payload):
    sys.stdout.write(json.dumps(payload, ensure_ascii=False))
    sys.stdout.write("\n")


def read_stdin_json():
    try:
        raw = sys.stdin.read()
        return json.loads(raw) if raw.strip() else {}
    except Exception:
        return {}


def context(event, text):
    emit({"hookSpecificOutput": {"hookEventName": event, "additionalContext": text}})


def notify():
    payload = read_stdin_json()
    tool_input = payload.get("tool_input") or {}
    tool_response = payload.get("tool_response") or {}
    path = tool_response.get("filePath") or tool_input.get("file_path") or ""
    if not path:
        return

    directory, name = os.path.split(os.path.normpath(path))
    if os.path.normcase(directory) != os.path.normcase(os.path.normpath(STORE)):
        return
    match = NOTE_RE.match(name)
    if not match:
        return  # README.md, INDEX.md, anything unnumbered

    # Icon plus three to five words. The icon already means "kept"; a label would
    # only repeat it, and the slug is already a compact noun phrase.
    words = match.group(2).split("-")[:5]
    emit({"systemMessage": "%s %s" % (ICON, " ".join(words))})


def main(argv):
    if disabled():
        return 0
    mode = argv[1] if len(argv) > 1 else ""
    if mode == "arm":
        focus = project_focus()
        text = ARM_TEXT + (" This project asks in particular for: " + focus) if focus else ARM_TEXT
        context("SessionStart", text)
    elif mode == "sweep":
        context("PreCompact", SWEEP_TEXT)
    elif mode == "notify":
        notify()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Exception:
        sys.exit(0)  # Never break a session over an archiving side-effect.
