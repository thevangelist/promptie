#!/usr/bin/env python3
"""Allocate the next running number for a {{NAME}} note and print its path.

Exists so the assistant never has to list the store to work out the next number:
this script does the counting and returns one path. No note content, and no other
note's name, ever reaches the caller.

Also enforces the capture rate cap. Counting is a script-side operation on the
store, which is fine -- the numbers never reach the assistant. Refusing here is
what keeps a high-sensitivity persona from filling the store with noise.

Pure standard library: no jq, no bash, no shell utilities. Runs identically on
macOS, Linux, BSD and Windows.

Generated by promptie from {{PERSONA_FILE}}. Edit the persona, not this file.

Usage: new_note.py <kebab-slug>   ->   {{STORE}}/000008-my-slug.md
"""

import datetime
import os
import re
import sys

STORE = os.path.expanduser(r"{{STORE}}")
MAX_PER_DAY = {{MAX_PER_DAY}}
STATE_DIR = os.path.join(os.path.expanduser("~"), ".cache", "promptie")

# Five characters. Decimal while decimal lasts, then a letter takes the leading
# position: 00001 .. 99999, A0000 .. A9999, B0000 .. Z9999. That is 359,999 ids,
# and because '9' sorts before 'A' in ASCII, lexicographic order still equals
# capture order. Legacy 6-to-9 digit names are still counted so an existing store
# keeps working.
NOTE_RE = re.compile(r"^([0-9][0-9A-Z]{4}|[A-Z]\d{4}|\d{6,9})-[a-z0-9-]+\.md$")
SLUG_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")


def fail(message):
    sys.stderr.write(message + "\n")
    raise SystemExit(2)


def counted_today():
    """How many notes this persona has already taken today.

    Kept outside the store so the store stays purely notes, and so clearing the
    counter never risks touching a note.
    """
    path = os.path.join(STATE_DIR, "{{NAME}}-%s.count" % datetime.date.today().isoformat())
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return int(fh.read().strip() or 0), path
    except (IOError, OSError, ValueError):
        return 0, path


def bump(path, value):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(str(value))
    except (IOError, OSError):
        pass  # A missing counter must never block a capture.


DECIMAL_MAX = 99999
LETTER_BLOCK = 10000


def encode(n):
    """Value -> five-character id."""
    if n <= DECIMAL_MAX:
        return "%05d" % n
    offset = n - DECIMAL_MAX - 1
    letter = offset // LETTER_BLOCK
    if letter > 25:
        fail("this store is full at %d notes. Archive it and start a fresh one."
             % (DECIMAL_MAX + 26 * LETTER_BLOCK))
    return "%s%04d" % (chr(ord("A") + letter), offset % LETTER_BLOCK)


def decode(text):
    """Five-character id -> value. Also accepts legacy all-digit names."""
    if text.isdigit():
        return int(text)
    return DECIMAL_MAX + 1 + (ord(text[0]) - ord("A")) * LETTER_BLOCK + int(text[1:])


def main(argv):
    if len(argv) != 2:
        fail("usage: new_note.py <kebab-slug>")

    slug = argv[1]
    if not SLUG_RE.match(slug):
        fail("slug must be lower-case kebab-case, got: %s" % slug)

    used, counter_path = counted_today()
    if MAX_PER_DAY and used >= MAX_PER_DAY:
        fail(
            "capture cap reached for today (%d/%d). Nothing was written. "
            "Tell the user the insight is worth keeping but the cap is hit; they can "
            "raise `max_per_day` in the persona, or clear %s."
            % (used, MAX_PER_DAY, counter_path)
        )

    os.makedirs(STORE, exist_ok=True)
    highest = 0
    for name in os.listdir(STORE):
        match = NOTE_RE.match(name)
        if match:
            highest = max(highest, decode(match.group(1)))

    bump(counter_path, used + 1)
    sys.stdout.write(os.path.join(STORE, "%s-%s.md" % (encode(highest + 1), slug)) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
